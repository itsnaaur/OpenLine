rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins are identified by a Firebase custom claim (see scripts/setup-admin.mjs)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidCategory(category) {
      return category in [
        'Workplace Safety & Health',
        'Sexual Harassment & Gender-Based Violence',
        'Bullying & Discrimination',
        'Data Privacy Violation',
        'Financial Misconduct',
        'Facility & Equipment Issue',
        'General Suggestion/Feedback'
      ];
    }

    function isValidUrgency(urgency) {
      return urgency in ['Low', 'Medium', 'High'];
    }

    function isValidMessage(message, sender) {
      return message is map
        && message.keys().hasOnly(['sender', 'text', 'timestamp'])
        && message.keys().hasAll(['sender', 'text', 'timestamp'])
        && message.sender == sender
        && message.text is string
        && message.text.size() > 0
        && message.text.size() <= 5000
        && message.timestamp is number;
    }

    // Evidence must be Firebase Storage download URLs for files in evidence/
    function isEvidenceUrl(url) {
      return url is string
        && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/?#]+/o/evidence%2F[A-Za-z0-9-]+[.](jpg|png|pdf)[?]alt=media&token=[A-Za-z0-9-]+');
    }

    function isValidEvidence(urls) {
      return urls is list
        && urls.size() >= 1
        && urls.size() <= 3
        && isEvidenceUrl(urls[0])
        && (urls.size() < 2 || isEvidenceUrl(urls[1]))
        && (urls.size() < 3 || isEvidenceUrl(urls[2]));
    }

    function isValidNewReport(reportId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['accessCode', 'category', 'urgency', 'description', 'status', 'createdAt', 'lastUpdated', 'messages', 'evidenceUrl'])
        && data.keys().hasAll(['accessCode', 'category', 'urgency', 'description', 'status', 'createdAt', 'lastUpdated', 'messages'])
        && data.accessCode is string
        && data.accessCode.matches('[0-9A-HJ-NP-Z]{4}-[0-9A-HJ-NP-Z]{4}-[0-9A-HJ-NP-Z]{4}')
        // The document ID must be the SHA-256 hash of the access code
        && reportId == hashing.sha256(data.accessCode).toHexString().lower()
        && isValidCategory(data.category)
        && isValidUrgency(data.urgency)
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 5000
        && data.status == 'New'
        && data.createdAt is number
        && math.abs(data.createdAt - request.time.toMillis()) < 600000
        && data.lastUpdated == data.createdAt
        && data.messages is list
        && data.messages.size() == 1
        && isValidMessage(data.messages[0], 'reporter')
        && (!('evidenceUrl' in data) || isValidEvidence(data.evidenceUrl));
    }

    // Reporters may only append one new message; earlier messages cannot be changed
    function isReporterAppend() {
      let before = resource.data;
      let after = request.resource.data;
      let count = before.messages.size();
      return after.diff(before).affectedKeys().hasOnly(['messages', 'lastUpdated'])
        && after.messages is list
        && count < 500
        && after.messages.size() == count + 1
        && after.messages[0:count] == before.messages
        && isValidMessage(after.messages[count], 'reporter')
        && after.lastUpdated is number
        && after.lastUpdated > before.lastUpdated;
    }

    function isValidAdminUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isAdmin()
        && after.diff(before).affectedKeys().hasOnly(['status', 'category', 'urgency', 'messages', 'lastUpdated', 'aiAnalysis', 'expireAt'])
        && after.status in ['New', 'In Progress', 'Resolved']
        && isValidCategory(after.category)
        && isValidUrgency(after.urgency)
        && after.messages is list
        && after.messages.size() >= before.messages.size()
        && (!('expireAt' in after) || after.expireAt is timestamp)
        && after.lastUpdated is number
        && after.lastUpdated > before.lastUpdated;
    }

    match /reports/{reportId} {
      // Document IDs are SHA-256 hashes of 12-character access codes, so a single
      // report can only be fetched by someone who knows its code.
      allow get: if true;
      // Listing or querying reports is admin-only (prevents bulk download)
      allow list: if isAdmin();
      allow create: if isValidNewReport(reportId);
      allow update: if isValidAdminUpdate() || isReporterAppend();
      allow delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
