rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Evidence files: evidence/<uuid>.<jpg|png|pdf>
    match /evidence/{fileName} {
      // Anyone can upload new evidence (anonymous reports). Existing files can't be
      // overwritten, and the content type must match the extension.
      allow create: if resource == null
        && request.resource.size < 5 * 1024 * 1024
        && fileName.matches('[A-Za-z0-9-]+[.](jpg|png|pdf)')
        && ((fileName.matches('.*[.]jpg') && request.resource.contentType == 'image/jpeg')
          || (fileName.matches('.*[.]png') && request.resource.contentType == 'image/png')
          || (fileName.matches('.*[.]pdf') && request.resource.contentType == 'application/pdf'));

      // The uploader needs a short window to fetch the download URL after uploading.
      // After that, files are only reachable through the tokenized URL saved on the report.
      allow get: if isAdmin() || request.time < resource.timeCreated + duration.value(15, 'm');
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
